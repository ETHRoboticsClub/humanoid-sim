"""The chatter gate's scoring (humanoid_sim.chatter_gate) on synthetic runner CSVs.

The pinned numbers are what humanoid-learning's ``eval.sim_gate.score_run`` (the Controls MuJoCo gate, validated against
the robot on 2026-11-17) gave for the same CSVs when this module was written; ``test_equals_learning_score`` compares
live when ``HUMANOID_LEARNING_SRC`` points at a humanoid-learning ``src`` directory. No physics, no Isaac Lab.
"""

import importlib
import os
import sys
from pathlib import Path

import numpy as np
import pytest

from humanoid_sim import chatter_gate as cg

NAMES = ["torso_lateral_bending", "hip_flexion_l", "hip_flexion_r", "knee_flexion_l", "ankle_dorsiflexion_l",
         "ankle_inversion_l", "ankle_dorsiflexion_r", "ankle_inversion_r", "shoulder_flexion_l"]
DEPLOY = {"joint_names": NAMES, "obs_total_dim": 6, "default_angles": [0.0, 0.1, -0.1, -0.28, 0.17, 0.0, 0.17, 0.0, -0.02],
          "action_scale": 0.25,
          "obs_layout": [{"name": "base_ang_vel", "start": 0, "end": 3, "scale": 0.2},
                         {"name": "projected_gravity", "start": 3, "end": 6, "scale": 1.0}]}

def make(path, hf_amp, lf_amp, seed=3, seconds=30.0, dt=0.02, clip_ankle=False):
    rng = np.random.default_rng(seed)
    t = np.arange(0, seconds, dt)
    n = len(NAMES)
    act = 0.004 * rng.standard_normal((len(t), n))
    act += hf_amp * np.sin(2 * np.pi * 4.3 * t[:, None] + np.arange(n))
    act += lf_amp * np.sin(2 * np.pi * 1.4 * t[:, None] + np.arange(n))
    raw = np.array(DEPLOY["default_angles"]) + DEPLOY["action_scale"] * act
    qdes = raw.copy()
    if clip_ankle:
        qdes[:, 4] = np.clip(qdes[:, 4], 0.165, 0.175)
    pitch = np.radians(0.8) * np.sin(2 * np.pi * 1.4 * t) * (lf_amp > 0) + np.radians(0.1) * rng.standard_normal(len(t))
    roll = np.radians(0.2) * rng.standard_normal(len(t)) + np.radians(2.0)
    g = np.stack([np.sin(pitch), -np.sin(roll), -np.cos(pitch) * np.cos(roll)], 1)
    g /= np.linalg.norm(g, axis=1, keepdims=True)
    gyro = np.stack([0.02 * rng.standard_normal(len(t)),
                     0.1 * np.cos(2 * np.pi * 1.4 * t) * (lf_amp > 0) + 0.02 * rng.standard_normal(len(t)),
                     0.01 * rng.standard_normal(len(t))], 1)
    obs = np.concatenate([gyro * 0.2, g], 1)
    cols = ["t"] + [f"obs{k}" for k in range(6)] + [f"act{k}" for k in range(n)] + [f"qdes{k}" for k in range(n)]
    np.savetxt(path, np.column_stack([t, obs, act, qdes]), delimiter=",", header=",".join(cols), comments="")
    return t

LOG = "base pos (end) = x0.10 y(fwd)0.20 z0.85"
WINDOW = (6.0, 30.0)
CASES = {"quiet": (0.001, 0.0, False), "chatter": (0.05, 0.0, True), "limit_cycle": (0.001, 0.2, False)}
# learning's score_run on make(...) of each case, window (6, 30)
PINNED = {
    "quiet": {"fell": False, "base_drift_m": 0.223606797749979, "lean_fwd_deg_mean": -0.0018054777215240707,
              "lean_lat_deg_mean": 1.9956415423138265, "tilt_deg_mean": 1.9980689360982644,
              "tilt_deg_p95": 2.3115696143146867, "tilt_deg_max": 2.7227704504748877,
              "sway_fwd_deg_std": 0.09825613731265512, "sway_lat_deg_std": 0.19211756523630188,
              "leg_target_power_above_3hz_share": 0.8817965730129739,
              "leg_target_above_3hz_rms_rad": 0.0009580577800828014, "ankle_clip_tick_share": 0.0,
              "any_clip_tick_share": 0.0, "chatter_pass": True, "pass": True},
    "chatter": {"fell": False, "base_drift_m": 0.223606797749979, "lean_fwd_deg_mean": -0.0018054777215240707,
                "lean_lat_deg_mean": 1.9956415423138265, "tilt_deg_mean": 1.9980689360982644,
                "tilt_deg_p95": 2.3115696143146867, "tilt_deg_max": 2.7227704504748877,
                "sway_fwd_deg_std": 0.09825613731265512, "sway_lat_deg_std": 0.19211756523630188,
                "leg_target_power_above_3hz_share": 0.9975740944956877,
                "leg_target_above_3hz_rms_rad": 0.008415451180489404, "ankle_clip_tick_share": 0.7283333333333334,
                "any_clip_tick_share": 0.7283333333333334, "chatter_pass": False, "pass": False},
    "limit_cycle": {"fell": False, "base_drift_m": 0.223606797749979, "lean_fwd_deg_mean": -0.008452071523294804,
                    "lean_lat_deg_mean": 1.9957368913987177, "tilt_deg_mean": 2.0750379362544322,
                    "tilt_deg_p95": 2.3899791227757228, "tilt_deg_max": 2.8220908230531223,
                    "sway_fwd_deg_std": 0.5691861108771481, "sway_lat_deg_std": 0.19212698525461144,
                    "leg_target_power_above_3hz_share": 0.0038117817433972957,
                    "leg_target_above_3hz_rms_rad": 0.0021829538473957153, "ankle_clip_tick_share": 0.0,
                    "any_clip_tick_share": 0.0, "chatter_pass": True, "pass": True},
}


@pytest.fixture(scope="module")
def csvs(tmp_path_factory):
    d = tmp_path_factory.mktemp("runs")
    out = {}
    for name, (hf, lf, clip) in CASES.items():
        out[name] = d / f"{name}.csv"
        make(out[name], hf, lf, clip_ankle=clip)
    return out


@pytest.mark.parametrize("name", CASES)
def test_score_csv_matches_the_pinned_controls_gate_numbers(csvs, name):
    s = cg.score_csv(csvs[name], DEPLOY, LOG, WINDOW)
    for key, want in PINNED[name].items():
        if isinstance(want, bool):
            assert s[key] is want, key
        else:
            assert s[key] == pytest.approx(want, rel=1e-9, abs=1e-12), key
    assert s["window_s"] == [6.0, pytest.approx(29.98)]


@pytest.mark.parametrize("name", CASES)
def test_equals_learning_score(csvs, name):
    src = os.environ.get("HUMANOID_LEARNING_SRC")
    if not src:
        pytest.skip("HUMANOID_LEARNING_SRC not set")
    sys.path.insert(0, src)
    try:
        theirs = importlib.import_module("humanoid_learning.eval.sim_gate").score_run
        want = theirs(csvs[name], DEPLOY, LOG, WINDOW)
    finally:
        sys.path.remove(src)
    got = cg.score_csv(csvs[name], DEPLOY, LOG, WINDOW)
    for key, value in want.items():
        if isinstance(value, dict):
            assert got[key] == value, key
        elif isinstance(value, float):
            assert got[key] == pytest.approx(value, rel=1e-12), key
        else:
            assert got[key] == value, key


def test_the_stand_cases_separate():
    quiet, chatter = PINNED["quiet"], PINNED["chatter"]
    assert cg.run_passes(quiet) and not cg.run_passes(chatter)
    assert not cg.chatter_passes({"leg_target_power_above_3hz_share": 0.5, "leg_target_above_3hz_rms_rad": 0.03})
    assert cg.chatter_passes({"leg_target_power_above_3hz_share": 0.05, "leg_target_above_3hz_rms_rad": 0.03})
    assert cg.chatter_passes({"leg_target_power_above_3hz_share": 0.5, "leg_target_above_3hz_rms_rad": 0.004})


def test_low_frequency_measures_see_a_limit_cycle_the_chatter_measure_does_not(csvs):
    quiet = cg.score_csv(csvs["quiet"], DEPLOY, LOG, WINDOW)
    cycle = cg.score_csv(csvs["limit_cycle"], DEPLOY, LOG, WINDOW)
    assert cycle["chatter_pass"] and quiet["chatter_pass"]
    assert cycle["pitch_dominant_hz"] == pytest.approx(1.4, abs=0.05)
    assert cycle["pitch_sway_deg"] > 5 * quiet["pitch_sway_deg"]
    assert cycle["pitch_rate_rms_rad_s"] > 3 * quiet["pitch_rate_rms_rad_s"]
    # a 0.8 degree amplitude sine: 0.57 degrees RMS, all of it in the 0.5 to 3 Hz band; the gyro's 0.1 rad/s: 0.07 RMS
    assert cycle["pitch_0p5_3hz_rms_deg"] == pytest.approx(0.8 / np.sqrt(2), rel=0.1)
    assert cycle["pitch_rate_0p5_3hz_rms_rad_s"] == pytest.approx(0.1 / np.sqrt(2), rel=0.1)
    assert quiet["pitch_0p5_3hz_rms_deg"] < 0.1


def test_score_run_takes_arrays_like_the_csv(csvs):
    d = np.genfromtxt(csvs["chatter"], delimiter=",", names=True)
    n = len(DEPLOY["joint_names"])
    qdes = np.stack([d[f"qdes{k}"] for k in range(n)], 1)
    act = np.stack([d[f"act{k}"] for k in range(n)], 1)
    raw = np.array(DEPLOY["default_angles"]) + DEPLOY["action_scale"] * act
    g = np.stack([d[f"obs{k}"] for k in (3, 4, 5)], 1)
    gyro = np.stack([d[f"obs{k}"] for k in (0, 1, 2)], 1) / 0.2
    s = cg.score_run(d["t"], qdes, raw, g, gyro, DEPLOY["joint_names"], WINDOW, base_end_xyz=[0.1, 0.2, 0.85])
    want = cg.score_csv(csvs["chatter"], DEPLOY, LOG, WINDOW)
    assert s == want


def test_a_fall_is_a_tilt_over_45_degrees_a_low_base_or_the_runs_own_flag(csvs):
    d = np.genfromtxt(csvs["quiet"], delimiter=",", names=True)
    n = len(DEPLOY["joint_names"])
    qdes = np.stack([d[f"qdes{k}"] for k in range(n)], 1)
    g = np.stack([d[f"obs{k}"] for k in (3, 4, 5)], 1)
    gyro = np.zeros_like(g)
    args = (d["t"], qdes, qdes, g, gyro, DEPLOY["joint_names"], WINDOW)
    assert not cg.score_run(*args, base_end_xyz=[0, 0, 0.85])["fell"]
    assert cg.score_run(*args, base_end_xyz=[0, 0, 0.5])["fell"]
    assert cg.score_run(*args, fell_flag=True)["fell"]
    tipped = g.copy()
    tipped[500] = [0.8, 0.0, -0.6]
    assert cg.score_run(d["t"], qdes, qdes, tipped, gyro, DEPLOY["joint_names"], WINDOW)["fell"]
    with pytest.raises(ValueError):
        cg.score_run(d["t"], qdes, qdes, g, gyro, DEPLOY["joint_names"], (100.0, 200.0))


def _runs(stand_ok=True, walk_fell=False, missing=None):
    ok = {"fell": False, "chatter_pass": True, "leg_target_above_3hz_rms_rad": 0.002,
          "leg_target_power_above_3hz_share": 0.5}
    out = {}
    for imu in cg.GATING_IMUS:
        for seed in cg.SEEDS:
            out[cg.run_name("stand", imu, seed)] = dict(ok, chatter_pass=stand_ok,
                                                        leg_target_above_3hz_rms_rad=0.002 if stand_ok else 0.04)
            out[cg.run_name("walk02", imu, seed)] = dict(ok, fell=walk_fell)
    if missing:
        del out[missing]
    return out


def test_verdict_passes_quiet_stands_and_walks_that_stay_up():
    assert cg.verdict(_runs()) == (True, [])


def test_verdict_fails_on_any_stand_chatter_with_the_reason():
    ok, reasons = cg.verdict(_runs(stand_ok=False))
    assert not ok and len(reasons) == 6
    assert reasons[0].startswith("stand_real_s0: chatter, 0.0400 rad RMS above 3 Hz")


def test_verdict_fails_on_a_walk_fall_a_missing_run_or_an_error():
    ok, reasons = cg.verdict(_runs(walk_fell=True))
    assert not ok and all(r.endswith("fell") for r in reasons) and len(reasons) == 6
    ok, reasons = cg.verdict(_runs(missing="stand_noimu_s2"))
    assert not ok and reasons == ["stand_noimu_s2: no result"]
    runs = _runs()
    runs["walk02_real_s1"] = {"error": "boom"}
    assert cg.verdict(runs) == (False, ["walk02_real_s1: no result (boom)"])
    assert not cg.verdict(_runs(), crosscheck_pass=False)[0]


def test_walk_chatter_and_the_low_frequency_measures_do_not_gate():
    runs = _runs()
    for name, s in runs.items():
        if name.startswith("walk02"):
            s.update(chatter_pass=False, leg_target_above_3hz_rms_rad=0.05, pitch_sway_deg=3.0)
    assert cg.verdict(runs)[0]


def test_summary_lists_per_seed_numbers_by_scenario_and_imu():
    s = cg.summary({cg.run_name("stand", "real", 1): {"leg_target_above_3hz_rms_rad": 0.01, "pitch_dominant_hz": 1.4}})
    assert s["stand_real"]["rms_above_3hz_rad"] == [None, 0.01, None]
    assert s["stand_real"]["pitch_dominant_hz"] == [None, 1.4, None]
    assert set(s) == {"stand_real", "stand_noimu", "walk02_real", "walk02_noimu"}
