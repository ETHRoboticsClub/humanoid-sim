+        mio: wp.array[wp.int32],
+        D: wp.array[wp.float32],
+        P_epoch: wp.array[wp.float32],
+        phase: wp.array[wp.int32],
+        epoch_dim: wp.array[wp.int32],
+        epoch_mio: wp.array[wp.int32],
+        epoch_vio: wp.array[wp.int32],
+        pending_delta: wp.array[wp.float32],
+        pending_apply: wp.array[wp.int32],
