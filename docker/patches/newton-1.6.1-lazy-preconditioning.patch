+"""Isolated ownership-state prototype; no Newton installation or API is modified.
+
+Representation transitions are device state, including sticky public exposure.
+Trusted scalar consumers must use the descriptor and source lower indices.
+"""
+
+import warp as wp
+from .precondition_rounding import precondition_entry
+from ..solvers.padmm.types import PADMMStatus
+
+
+@wp.kernel(enable_backward=False)
+def zero_matrix(matrix: wp.array[float]):
+    matrix[wp.tid()] = 0.0
+
+
+@wp.kernel(enable_backward=False)
+def expose(flag: wp.array[int]):
+    flag[0] = 1
+
+
+@wp.kernel(enable_backward=False)
+def reset_epoch(phase: wp.array[int]):
+    phase[wp.tid()] = 0
+
+
+@wp.kernel(enable_backward=False)
+def capture_epoch(
+    dim: wp.array[int],
+    mio: wp.array[int],
+    vio: wp.array[int],
+    edim: wp.array[int],
+    emio: wp.array[int],
+    evio: wp.array[int],
+    phase: wp.array[int],
+):
+    w = wp.tid()
+    edim[w] = dim[w]
+    emio[w] = mio[w]
+    evio[w] = vio[w]
+    phase[w] = 1
+
+
+@wp.kernel(enable_backward=False)
+def materialize(
+    matrix: wp.array[float],
+    P: wp.array[float],
+    dim: wp.array[int],
+    mio: wp.array[int],
+    vio: wp.array[int],
+    phase: wp.array[int],
+    delta: wp.array[float],
+    apply: wp.array[int],
+    flag: wp.array[int],
+    exposed_only: int,
+    required_phase: int,
+):
+    w, lane = wp.tid()
+    p = phase[w]
+    if p == 0 or (exposed_only != 0 and flag[0] == 0) or (required_phase != 0 and p != required_phase):
+        return
+    n = dim[w]
+    for k in range(lane, n * n, 1024):
+        i = k // n
+        j = k % n
+        idx = mio[w] + k
+        value = precondition_entry(P[vio[w] + i], P[vio[w] + j], matrix[idx])
+        if p == 2 and apply[w] != 0 and i == j:
+            value = value + delta[w]
+        matrix[idx] = value
+
+
+@wp.kernel(enable_backward=False)
+def finish_materialize(phase: wp.array[int], flag: wp.array[int], exposed_only: int, required_phase: int):
+    w = wp.tid()
+    p = phase[w]
+    if p != 0 and (exposed_only == 0 or flag[0] != 0) and (required_phase == 0 or p == required_phase):
+        phase[w] = 0
+
+
+@wp.kernel(enable_backward=False)
+def mark_changed_layout(
+    phase: wp.array[int],
+    dim: wp.array[int],
+    mio: wp.array[int],
+    vio: wp.array[int],
+    edim: wp.array[int],
+    emio: wp.array[int],
+    evio: wp.array[int],
+):
+    w = wp.tid()
+    if phase[w] == 1 and (dim[w] != edim[w] or mio[w] != emio[w] or vio[w] != evio[w]):
+        phase[w] = 3
+
+
+@wp.kernel(enable_backward=False)
+def source_delta(
+    sigma: wp.array[wp.vec2f], converged: wp.array[PADMMStatus], delta: wp.array[float], apply: wp.array[int]
+):
+    w = wp.tid()
+    delta[w] = sigma[w][0] - sigma[w][1]
+    apply[w] = wp.int32(converged[w].converged <= 0)
+
+
+@wp.kernel(enable_backward=False)
+def add_if_materialized(
+    matrix: wp.array[float],
+    dim: wp.array[int],
+    mio: wp.array[int],
+    phase: wp.array[int],
+    delta: wp.array[float],
+    apply: wp.array[int],
+):
+    w, i = wp.tid()
+    if i < dim[w] and phase[w] == 0 and apply[w] != 0:
+        idx = mio[w] + i * dim[w] + i
+        matrix[idx] = matrix[idx] + delta[w]
+
+
+@wp.kernel(enable_backward=False)
+def record_pending(phase: wp.array[int]):
+    w = wp.tid()
+    if phase[w] == 1:
+        phase[w] = 2
+
+
+@wp.kernel(enable_backward=False)
+def eager_precondition(
+    matrix: wp.array[float], P: wp.array[float], dim: wp.array[int], mio: wp.array[int], vio: wp.array[int]
+):
+    w, lane = wp.tid()
+    n = dim[w]
+    for k in range(lane, n * n, 1024):
+        i = k // n
+        j = k % n
+        idx = mio[w] + k
+        matrix[idx] = P[vio[w] + i] * (P[vio[w] + j] * matrix[idx])
+
+
+@wp.kernel(enable_backward=False)
+def eager_delta(
+    matrix: wp.array[float],
+    dim: wp.array[int],
+    mio: wp.array[int],
+    sigma: wp.array[wp.vec2f],
+    converged: wp.array[PADMMStatus],
+):
+    w, i = wp.tid()
+    if i < dim[w] and converged[w].converged <= 0:
+        idx = mio[w] + i * dim[w] + i
+        matrix[idx] = matrix[idx] + (sigma[w][0] - sigma[w][1])
+
+
+@wp.func
+def read_entry(
+    matrix: wp.array[float],
+    P: wp.array[float],
+    phase: wp.array[int],
+    dim: wp.array[int],
+    mio: wp.array[int],
+    vio: wp.array[int],
+    delta: wp.array[float],
+    apply: wp.array[int],
+    current_dim: wp.array[int],
+    current_mio: wp.array[int],
+    w: int,
+    i: int,
+    j: int,
+):
+    value = wp.float32(0.0)
+    if phase[w] == 0:
+        value = matrix[current_mio[w] + i * current_dim[w] + j]
+    else:
+        value = matrix[mio[w] + i * dim[w] + j]
+    if phase[w] != 0:
+        value = precondition_entry(P[vio[w] + i], P[vio[w] + j], value)
+        if phase[w] == 2 and apply[w] != 0 and i == j:
+            value = value + delta[w]
+    return value
+
+
+class LazyDenseOwner:
+    """Constructor-only opt-in, preserves the supplied array object/pointer.
+
+    Calls assume the caller's normal ordered device stream, like existing Warp
+    arrays. No cross-stream concurrency or arbitrary private-storage mutation is
+    introduced. The eager default allocates no representation buffers.
+    """
+
+    def __init__(self, matrix, P, dim, mio, vio, maxdim, *, enabled=False, stream=None):
+        self.matrix = matrix
+        self.P = P
+        self.dim = dim
+        self.mio = mio
+        self.vio = vio
+        self.count = len(dim)
+        self.maxdim = int(maxdim)
+        self.enabled = bool(enabled)
+        self.device = matrix.device
+        self.stream = stream
+        self.public_exposed = None
+        self.has_public_alias = False
+        if enabled:
+            self.public_exposed = wp.zeros(1, dtype=int, device=self.device)
+            self.phase = wp.zeros(self.count, dtype=int, device=self.device)
+            self.P_epoch = wp.empty_like(P)
+            self.epoch_dim = wp.empty_like(dim)
+            self.epoch_mio = wp.empty_like(mio)
+            self.epoch_vio = wp.empty_like(vio)
+            self.delta = wp.zeros(self.count, dtype=float, device=self.device)
+            self.apply = wp.zeros(self.count, dtype=int, device=self.device)
+
+    def launch(self, kernel, dim, args, block=256):
+        wp.launch(kernel, dim=dim, inputs=args, device=self.device, stream=self.stream, block_dim=block)
+
+    def _materialize(self, exposed_only=0, required_phase=0):
+        if not self.enabled:
+            return
+        self.launch(
+            materialize,
+            (self.count, 1024),
+            [
+                self.matrix,
+                self.P_epoch,
+                self.epoch_dim,
+                self.epoch_mio,
+                self.epoch_vio,
+                self.phase,
+                self.delta,
+                self.apply,
+                self.public_exposed,
+                exposed_only,
+                required_phase,
+            ],
+        )
+        self.launch(
+            finish_materialize, self.count, [self.phase, self.public_exposed, exposed_only, required_phase]
+        )
+
+    def materialize_internal(self):
+        self._materialize()
+
+    def expose_public(self):
+        if self.enabled and not self.has_public_alias:
+            stream = self.stream
+            if self.device.is_cuda and stream is None:
+                stream = wp.get_stream(self.device)
+            capturing = stream.is_capturing if stream is not None else self.device.is_capturing
+            if capturing:
+                raise RuntimeError(
+                    "Lazy Delassus first public exposure must occur outside graph capture; access data/D/operator/solver before capture to retain eager cached-alias publication."
+                )
+            self.launch(expose, 1, [self.public_exposed])
+            self._materialize()
+            self.has_public_alias = True
+        return self.matrix
+
+    def begin_build(self, *, reset_to_zero):
+        if not self.enabled:
+            return
+        if reset_to_zero:
+            self.launch(reset_epoch, self.count, [self.phase])
+        else:
+            self.materialize_internal()
+        # Existing physical builder owns its original clearing/assembly here.
+
+    def finish_preconditioning(self):
+        if not self.enabled:
+            self.launch(
+                eager_precondition, (self.count, 1024), [self.matrix, self.P, self.dim, self.mio, self.vio]
+            )
+            return
+        # Repeated precondition calls are sequential rounded transformations.
+        self.materialize_internal()
+        wp.copy(self.P_epoch, self.P, stream=self.stream)
+        self.launch(
+            capture_epoch,
+            self.count,
+            [self.dim, self.mio, self.vio, self.epoch_dim, self.epoch_mio, self.epoch_vio, self.phase],
+        )
+        self._materialize(exposed_only=1)
+
+    def source_proximal_update(self, sigma, converged):
+        if not self.enabled:
+            self.launch(
+                eager_delta, (self.count, self.maxdim), [self.matrix, self.dim, self.mio, sigma, converged]
+            )
+            return
+        # A proximal write uses CURRENT layout, while pending P owns its old epoch.
+        self.launch(
+            mark_changed_layout,
+            self.count,
+            [self.phase, self.dim, self.mio, self.vio, self.epoch_dim, self.epoch_mio, self.epoch_vio],
+        )
+        self._materialize(required_phase=3)
+        # Never combine two rounded diagonal updates into an algebraic sum.
+        self._materialize(required_phase=2)
+        self.launch(source_delta, self.count, [sigma, converged, self.delta, self.apply])
+        self.launch(
+            add_if_materialized,
+            (self.count, self.maxdim),
+            [self.matrix, self.dim, self.mio, self.phase, self.delta, self.apply],
+        )
+        self.launch(record_pending, self.count, [self.phase])
+        self._materialize(exposed_only=1)
+
+    def zero(self):
+        # Public zero retains full-allocation clearing, including padding.
+        self.launch(zero_matrix, len(self.matrix), [self.matrix])
+        if self.enabled:
+            self.launch(reset_epoch, self.count, [self.phase])
+
+
+    def discard_epoch(self):
+        if self.enabled:
+            self.launch(reset_epoch, self.count, [self.phase])
+
+    def descriptor(self):
+        return [self.P_epoch, self.phase, self.epoch_dim, self.epoch_mio,
+                self.epoch_vio, self.delta, self.apply]
