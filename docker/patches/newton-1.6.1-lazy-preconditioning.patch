+#else
+    volatile float result = a * b;
+    return result;
+#endif
+''')
+def multiply_rn(a: wp.float32, b: wp.float32) -> wp.float32: ...
+
+@wp.func
+def precondition_entry(pi: wp.float32, pj: wp.float32, raw: wp.float32) -> wp.float32:
+    return multiply_rn(pi, multiply_rn(pj, raw))
