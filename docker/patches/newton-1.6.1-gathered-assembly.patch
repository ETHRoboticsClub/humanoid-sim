+# Blocks a row keeps in the row table of the gathered assembly; a row with more takes the scan path.
+_ROW_TABLE_BLOCKS = 2
+
+
+@wp.kernel
+def _row_tables_reset(
+    dim: wp.array[int],
+    rows: int,
+    count: wp.array[int],
+    mask: wp.array[wp.uint32],
+):
+    w, r = wp.tid()
+    if r < dim[w]:
+        count[w * rows + r] = 0
+        mask[w * rows + r] = wp.uint32(0)
+
+
+@wp.kernel
+def _row_tables_fill(
+    nzb: wp.array[int],
+    start: wp.array[int],
+    coords: wp.array2d[int],
+    dim: wp.array[int],
+    rows: int,
+    count: wp.array[int],
+    mask: wp.array[wp.uint32],
+    blocks: wp.array[int],
+):
+    w, i = wp.tid()
+    if i >= nzb[w]:
+        return
+    idx = start[w] + i
+    r = coords[idx, 0]
+    if r < 0 or r >= dim[w]:
+        return
+    row = w * rows + r
+    # One bit per body, shared by bodies 32 apart: an overlap test that may over-report, never under-report.
+    wp.atomic_or(mask, row, wp.uint32(1) << wp.uint32((coords[idx, 1] // 6) & 31))
+    slot = wp.atomic_add(count, row, 1)
+    if slot < 2:
+        blocks[2 * row + slot] = idx
+
+
+@wp.func
+def _block_pair_product(vi: vec6f, vj: vec6f, inv_m: float, inv_I: wp.mat33f):
+    Ji_v = wp.vec3f(vi[0], vi[1], vi[2])
+    Ji_w = wp.vec3f(vi[3], vi[4], vi[5])
+    Jj_v = wp.vec3f(vj[0], vj[1], vj[2])
+    Jj_w = wp.vec3f(vj[3], vj[4], vj[5])
+    return inv_m * wp.dot(Ji_v, Jj_v) + wp.dot(Ji_w, inv_I @ Jj_w)
+
+
+@wp.func
+def _gathered_entry(
+    w: int,
+    lo: int,
+    hi: int,
+    rows: int,
+    bio: wp.array[int],
+    inv_m: wp.array[float],
+    inv_I: wp.array[wp.mat33f],
+    nzb: wp.array[int],
+    start: wp.array[int],
+    coords: wp.array2d[int],
+    values: wp.array[vec6f],
+    count: wp.array[int],
+    blocks: wp.array[int],
+):
+    """J_lo M^-1 J_hi^T: the products of the two rows' blocks on the same body, the lower row index first."""
+    value = float(0.0)
+    row_lo = w * rows + lo
+    row_hi = w * rows + hi
+    n_lo = count[row_lo]
+    n_hi = count[row_hi]
+    if n_lo <= 2 and n_hi <= 2:
+        for a in range(n_lo):
+            ia = blocks[2 * row_lo + a]
+            body = coords[ia, 1] // 6
+            for b in range(n_hi):
+                ib = blocks[2 * row_hi + b]
+                if coords[ib, 1] // 6 == body:
+                    g = bio[w] + body
+                    value += _block_pair_product(values[ia], values[ib], inv_m[g], inv_I[g])
+    else:
+        first = start[w]
+        last = first + nzb[w]
+        for ia in range(first, last):
+            if coords[ia, 0] == lo:
+                body = coords[ia, 1] // 6
+                for ib in range(first, last):
+                    if coords[ib, 0] == hi and coords[ib, 1] // 6 == body:
+                        g = bio[w] + body
+                        value += _block_pair_product(values[ia], values[ib], inv_m[g], inv_I[g])
+    return value
+
+
+@wp.kernel
+def _assemble_delassus_gathered(
+    bio: wp.array[int],
+    inv_m: wp.array[float],
+    inv_I: wp.array[wp.mat33f],
+    nzb: wp.array[int],
+    start: wp.array[int],
+    coords: wp.array2d[int],
+    values: wp.array[vec6f],
+    dim: wp.array[int],
+    highwater: wp.array[int],
+    mio: wp.array[int],
+    rows: int,
+    count: wp.array[int],
+    mask: wp.array[wp.uint32],
+    blocks: wp.array[int],
+    D: wp.array[float],
+):
+    """Writes every entry of the world's active prefix once (the clear and the assembly in one pass)."""
+    w, lane = wp.tid()
+    n = dim[w]
+    base = mio[w]
+    for k in range(lane, n * n, 1024):
+        i = k // n
+        j = k - i * n
+        lo = wp.min(i, j)
+        hi = wp.max(i, j)
+        value = float(0.0)
+        if (mask[w * rows + lo] & mask[w * rows + hi]) != wp.uint32(0):
+            value = _gathered_entry(w, lo, hi, rows, bio, inv_m, inv_I, nzb, start, coords, values, count, blocks)
+        D[base + k] = value
+    # Entries a larger earlier prefix left behind lie beyond this one.
+    total = wp.max(n, highwater[w])
+    for k in range(n * n + lane, total * total, 1024):
+        D[base + k] = float(0.0)
+
+
+class _GatheredDelassus:
+    """The Delassus matrix of a sparse Jacobian, one entry at a time from the two rows' blocks.
+
+    Each entry of the dense prefix is the sum, over the bodies both rows touch, of the rows' block products
+    (a mask of bodies per row rules out the pairs that touch none). It writes the prefix and the zero tail of the
+    previous one in a single pass, with no atomics on the matrix and no bucketing of blocks by body.
+    """
+
+    def __init__(self, jacobian, num_worlds, rows, device):
+        self.jacobian = jacobian
+        self.device = device
+        self.worlds = num_worlds
+        self.rows = rows
+        self.count = wp.zeros(num_worlds * rows, dtype=int, device=device)
+        self.mask = wp.zeros(num_worlds * rows, dtype=wp.uint32, device=device)
+        self.blocks = wp.zeros(num_worlds * rows * _ROW_TABLE_BLOCKS, dtype=int, device=device)
+
+    def assemble(self, bio, inv_mass, inv_inertia, dim, highwater, mio, matrix):
+        jac = self.jacobian
+        wp.launch(
+            _row_tables_reset,
+            dim=(self.worlds, self.rows),
+            inputs=[dim, self.rows, self.count, self.mask],
+            device=self.device,
+        )
+        wp.launch(
+            _row_tables_fill,
+            dim=(self.worlds, jac.max_of_num_nzb),
+            inputs=[jac.num_nzb, jac.nzb_start, jac.nzb_coords, dim, self.rows, self.count, self.mask, self.blocks],
+            device=self.device,
+        )
+        wp.launch(
+            _assemble_delassus_gathered,
+            dim=(self.worlds, 1024),
+            inputs=[
+                bio,
+                inv_mass,
+                inv_inertia,
+                jac.num_nzb,
+                jac.nzb_start,
+                jac.nzb_coords,
+                jac.nzb_values,
+                dim,
+                highwater,
+                mio,
+                self.rows,
+                self.count,
+                self.mask,
+                self.blocks,
+                matrix,
+            ],
+            block_dim=256,
+            device=self.device,
+        )
+
+
