@@ -0,0 +1,114 @@
+"""Frozen sparse-load diagnostics; all original arithmetic and cadence retained."""
+
+import warp as wp
+from newton._src.solvers.kamino._src.solvers.padmm.math import (
+    compute_box_complementarity_residual,
+    project_to_coulomb_cone,
+)
+
+
+@wp.func_native("""
+float r = value;
+#pragma unroll
+for (int offset = 16; offset > 0; offset >>= 1)
+    r += __shfl_xor_sync(0xffffffffu, r, offset, 32);
+return r;
+""")
+def warp_sum(value: wp.float32) -> wp.float32: ...
+
+
+def make_sparse(capacity):
+    CAPACITY = wp.constant(capacity)
+    WARPS = wp.constant(4)
+
+    @wp.kernel(enable_backward=False)
+    def sparse_warp(
+        D: wp.array[float],
+        q: wp.array[float],
+        P: wp.array[float],
+        dim: wp.array[int],
+        mio: wp.array[int],
+        vio: wp.array[int],
+        nbc: wp.array[int],
+        nl: wp.array[int],
+        bcgo: wp.array[int],
+        lcgo: wp.array[int],
+        ccgo: wp.array[int],
+        bcio: wp.array[int],
+        cio: wp.array[int],
+        lower: wp.array[float],
+        upper: wp.array[float],
+        mu: wp.array[float],
+        x: wp.array[float],
+        y: wp.array[float],
+        z: wp.array[float],
+        sigma: float,
+        row_masks: wp.array2d[wp.uint32],
+        dense: wp.array[int],
+        result: wp.array2d[float],
+    ):
+        w, thread = wp.tid()
+        n = dim[w]
+        lane = thread % 32
+        warp = thread // 32
+        masks = wp.tile_load(row_masks, shape=(1, CAPACITY), offset=(w, 0), storage="shared")
+        use_dense = dense[w] != 0
+        stationarity = wp.float32(0.0)
+        feasibility = wp.float32(0.0)
+        natural_map = wp.float32(0.0)
+        complementarity = wp.float32(0.0)
+        for k in range(warp, n, WARPS):
+            partial = wp.float32(0.0)
+            for j in range(lane, n, 32):
+                value = wp.float32(0.0)
+                if use_dense or k == j:
+                    value = D[mio[w] + k * n + j]
+                elif (masks[0, k] & masks[0, j]) != wp.uint32(0):
+                    value = D[mio[w] + k * n + j]
+                partial = partial + value * y[vio[w] + j]
+            product = warp_sum(partial)
+            if lane == 0:
+                idx = vio[w] + k
+                pv = P[idx]
+                yv = y[idx]
+                zv = z[idx]
+                correction = wp.float32(0.0)
+                pr = yv
+                natural = yv - zv
+                comp = wp.float32(0.0)
+                if k >= bcgo[w] and k < bcgo[w] + nbc[w]:
+                    j = bcio[w] + k - bcgo[w]
+                    lo = lower[j]
+                    hi = upper[j]
+                    pr = wp.clamp(yv, lo, hi)
+                    natural = wp.clamp(yv - zv, lo, hi)
+                    comp = wp.abs(compute_box_complementarity_residual(yv, zv, lo, hi))
+                elif k >= lcgo[w] and k < lcgo[w] + nl[w]:
+                    pr = wp.max(yv, 0.0)
+                    natural = wp.max(yv - zv, 0.0)
+                    comp = wp.abs(yv * zv)
+                elif k >= ccgo[w]:
+                    component = (k - ccgo[w]) % 3
+                    j = idx - component
+                    m = mu[cio[w] + (k - ccgo[w]) // 3]
+                    yy = wp.vec3f(y[j], y[j + 1], y[j + 2])
+                    zz = wp.vec3f(z[j], z[j + 1], z[j + 2])
+                    pr = project_to_coulomb_cone(yy, m)[component]
+                    natural = project_to_coulomb_cone(yy - zz, m)[component]
+                    if component == 2:
+                        correction = m * wp.sqrt(z[j] * z[j] + z[j + 1] * z[j + 1])
+                    if component == 0:
+                        comp = wp.abs(wp.dot(yy, zz))
+                value = q[idx] + correction - zv - sigma * yv
+                value = value + product
+                stationarity = wp.max(stationarity, wp.abs(value / pv))
+                feasibility = wp.max(feasibility, wp.abs(pv * (yv - pr)))
+                natural_map = wp.max(natural_map, wp.abs(yv - natural))
+                complementarity = wp.max(complementarity, comp)
+        if lane == 0:
+            wp.atomic_max(result, w, 0, stationarity)
+            wp.atomic_max(result, w, 1, feasibility)
+            wp.atomic_max(result, w, 2, natural_map)
+            wp.atomic_max(result, w, 3, complementarity)
+
+    return sparse_warp
