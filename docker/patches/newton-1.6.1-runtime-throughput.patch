@@ -0,0 +1,121 @@
+"""Exact backward-solve derivative with direct padded inverse publication."""
+
+import warp as wp
+from newton._src.solvers.kamino._src.linalg.factorize.llt_blocked import get_float32_array_offset_ptr
+from newton._src.solvers.kamino._src.linalg.factorize.rcm_batch import _sync_threads
+
+
+def make_inverse_publication(block=32):
+    @wp.kernel(module="unique", enable_backward=False)
+    def solve(
+        L: wp.array[wp.float32],
+        dims: wp.array[wp.int32],
+        mio: wp.array[wp.int32],
+        free: int,
+        max_reduced: int,
+        column_blocks: int,
+        Y: wp.array[wp.float32],
+        X: wp.array[wp.float32],
+        capacity: int,
+        qr: wp.array[wp.float32],
+        published: wp.array[wp.float32],
+        outq: wp.array2d[wp.float32],
+    ):
+        job, lane = wp.tid()
+        w = job // column_blocks
+        column = (job % column_blocks) * block
+        n = dims[w]
+        r = n - free
+        threads = wp.block_dim()
+        # Each column CTA owns the corresponding transposed output rows.
+        # Initialize every capacity entry, including column CTAs with no solve.
+        for index in range(lane, block * capacity, threads):
+            row = column + index // capacity
+            col = index % capacity
+            if row < capacity:
+                published[w * capacity * capacity + row * capacity + col] = wp.float32(0.0)
+        for index in range(lane, block, threads):
+            row = column + index
+            if row < capacity:
+                value = wp.float32(0.0)
+                if row < r:
+                    value = qr[w * max_reduced + row]
+                outq[w, row] = value
+        _sync_threads()
+        if column >= r:
+            return
+        published_matrix = wp.array(
+            ptr=get_float32_array_offset_ptr(published, w * capacity * capacity),
+            shape=(capacity, capacity),
+            dtype=wp.float32,
+        )
+        lm = wp.array(ptr=get_float32_array_offset_ptr(L, mio[w]), shape=(n, n), dtype=wp.float32)
+        ym = wp.array(
+            ptr=get_float32_array_offset_ptr(Y, w * max_reduced * max_reduced),
+            shape=(r, max_reduced),
+            dtype=wp.float32,
+        )
+        xm = wp.array(
+            ptr=get_float32_array_offset_ptr(X, w * max_reduced * max_reduced),
+            shape=(r, max_reduced),
+            dtype=wp.float32,
+        )
+        padded = (r + block - 1) // block * block
+        for i in range(0, padded, block):
+            rhs = wp.tile_zeros(shape=(block, block), dtype=wp.float32, storage="shared")
+            for chunk in range((block * block + threads - 1) // threads):
+                k = (lane + chunk * threads) % (block * block)
+                row = k // block
+                col = k % block
+                value = wp.float32(0.0)
+                if i + row == column + col and i + row < r:
+                    value = wp.float32(1.0)
+                rhs[row, col] = value
+            diag = wp.tile_load(lm, shape=(block, block), offset=(free + i, free + i), storage="shared")
+            if i + block > r:
+                for chunk in range((block * block + threads - 1) // threads):
+                    k = (lane + chunk * threads) % (block * block)
+                    row = k // block
+                    col = k % block
+                    value = diag[row, col]
+                    if i + row >= r or i + col >= r:
+                        value = wp.where(row == col, wp.float32(1.0), wp.float32(0.0))
+                    diag[row, col] = value
+            for j in range(0, i, block):
+                lb = wp.tile_load(lm, shape=(block, block), offset=(free + i, free + j))
+                yb = wp.tile_load(ym, shape=(block, block), offset=(j, column))
+                wp.tile_matmul(lb, yb, rhs, alpha=-1.0)
+            wp.tile_lower_solve_inplace(diag, rhs)
+            wp.tile_store(ym, rhs, offset=(i, column))
+        for i in range(padded - block, -1, -block):
+            rhs = wp.tile_load(ym, shape=(block, block), offset=(i, column), storage="shared")
+            diag = wp.tile_load(lm, shape=(block, block), offset=(free + i, free + i), storage="shared")
+            if i + block > r:
+                for chunk in range((block * block + threads - 1) // threads):
+                    k = (lane + chunk * threads) % (block * block)
+                    row = k // block
+                    col = k % block
+                    value = diag[row, col]
+                    if i + row >= r or i + col >= r:
+                        value = wp.where(row == col, wp.float32(1.0), wp.float32(0.0))
+                    diag[row, col] = value
+            for j in range(i + block, padded, block):
+                lb = wp.tile_load(lm, shape=(block, block), offset=(free + j, free + i))
+                xb = wp.tile_load(xm, shape=(block, block), offset=(j, column))
+                wp.tile_matmul(wp.tile_transpose(lb), xb, rhs, alpha=-1.0)
+            wp.tile_upper_solve_inplace(wp.tile_transpose(diag), rhs)
+            wp.tile_store(xm, rhs, offset=(i, column))
+            # Preserve the scratch solve unchanged; publish a separate shared tile
+            # so masking output padding cannot change subsequent backward updates.
+            final = wp.tile_zeros(shape=(block, block), dtype=wp.float32, storage="shared")
+            for chunk in range((block * block + threads - 1) // threads):
+                index = lane + chunk * threads
+                row = index // block
+                col = index % block
+                value = wp.float32(0.0)
+                if i + row < r and column + col < r:
+                    value = rhs[row, col]
+                final[row, col] = value
+            wp.tile_store(published_matrix, wp.tile_transpose(final), offset=(column, i))
+
+    return solve
