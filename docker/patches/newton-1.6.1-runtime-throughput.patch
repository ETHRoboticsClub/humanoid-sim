@@ -0,0 +1,75 @@
+"""Fresh sparse-assembly certificate and topology guards; never infer numerical zeros."""
+
+import warp as wp
+
+
+@wp.kernel(enable_backward=False)
+def build_masks(
+    coords: wp.array2d[int],
+    starts: wp.array[int],
+    counts: wp.array[int],
+    dim: wp.array[int],
+    bodies: wp.array[int],
+    fresh_sparse: wp.array[int],
+    max_entries: int,
+    masks: wp.array2d[wp.uint32],
+    dense: wp.array[int],
+):
+    w, k = wp.tid()
+    n = dim[w]
+    valid = fresh_sparse[w] != 0 and bodies[w] > 0 and bodies[w] <= 32 and n >= 0 and n <= masks.shape[1]
+    valid = (
+        valid
+        and starts[w] >= 0
+        and counts[w] >= 0
+        and counts[w] <= max_entries
+        and starts[w] + counts[w] <= coords.shape[0]
+    )
+    if not valid:
+        wp.atomic_or(dense, w, 1)
+    elif k < counts[w]:
+        r = coords[starts[w] + k, 0]
+        col = coords[starts[w] + k, 1]
+        if r < 0 or r >= n or col < 0 or col % 6 != 0 or col // 6 >= bodies[w]:
+            wp.atomic_or(dense, w, 2)
+        else:
+            wp.atomic_or(masks, w, r, wp.uint32(1) << wp.uint32(col // 6))
+
+
+@wp.kernel(enable_backward=False)
+def guard_preconditioner(P: wp.array[float], dim: wp.array[int], vio: wp.array[int], dense: wp.array[int]):
+    w, lane = wp.tid()
+    for row in range(lane, dim[w], 128):
+        p = P[vio[w] + row]
+        if not wp.isfinite(p) or p <= 0.0:
+            wp.atomic_or(dense, w, 4)
+
+
+@wp.kernel(enable_backward=False)
+def audit_products(
+    D: wp.array[float],
+    y: wp.array[float],
+    dim: wp.array[int],
+    mio: wp.array[int],
+    vio: wp.array[int],
+    masks: wp.array2d[wp.uint32],
+    dense: wp.array[int],
+    source: wp.array3d[float],
+    candidate: wp.array3d[float],
+):
+    w, k, lane = wp.tid()
+    if k < dim[w]:
+        n = dim[w]
+        original = wp.float32(0.0)
+        sparse = wp.float32(0.0)
+        for j in range(lane, n, 32):
+            d = D[mio[w] + k * n + j]
+            value = wp.float32(0.0)
+            if dense[w] != 0 or k == j:
+                value = d
+            elif (masks[w, k] & masks[w, j]) != wp.uint32(0):
+                value = d
+            original = original + d * y[vio[w] + j]
+            sparse = sparse + value * y[vio[w] + j]
+        source[w, k, lane] = original
+        candidate[w, k, lane] = sparse
