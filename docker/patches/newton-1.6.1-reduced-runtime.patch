+"""Width-specialized matrix cache; exact original128-thread PADMM reductions.
+
+A different finite iteration algorithm after exact bilateral elimination.
+No production imports/patches except Newton's published mathematical helpers.
+The reduced inverse is loaded once per world into shared memory, transposed to
+avoid a bank conflict when all lanes apply separate rows to the same vector.
+"""
+
+import warp as wp
+from newton._src.solvers.kamino._src.linalg.factorize.rcm_batch import _sync_threads
+from newton._src.solvers.kamino._src.solvers.padmm.math import (
+    compute_box_complementarity_residual,
+    project_to_coulomb_cone,
+)
+
+
+def make_width_kernel(compute_width=64, storage_pitch=96, min_dimension=1, threads=128):
+    assert compute_width in (32, 64, 96)
+    assert storage_pitch == 96 and threads == 128
+    assert 1 <= min_dimension <= compute_width
+    assert compute_width * compute_width % threads == 0
+
+    @wp.kernel(module="unique", enable_backward=False)
+    def solve(
+        inverse_transposed: wp.array2d[wp.float32],
+        q: wp.array2d[wp.float32],
+        P: wp.array2d[wp.float32],
+        lower: wp.array2d[wp.float32],
+        upper: wp.array2d[wp.float32],
+        mu: wp.array2d[wp.float32],
+        seed_x: wp.array2d[wp.float32],
+        seed_y: wp.array2d[wp.float32],
+        seed_z: wp.array2d[wp.float32],
+        seed_y_hat: wp.array2d[wp.float32],
+        seed_z_hat: wp.array2d[wp.float32],
+        dims: wp.array[wp.int32],
+        nbc: wp.array[wp.int32],
+        nl: wp.array[wp.int32],
+        eta: wp.float32,
+        rho: wp.float32,
+        a0: wp.float32,
+        restart_tolerance: wp.float32,
+        primal_tolerance: wp.float32,
+        dual_tolerance: wp.float32,
+        compl_tolerance: wp.float32,
+        max_iterations: int,
+        out_x: wp.array2d[wp.float32],
+        out_y: wp.array2d[wp.float32],
+        out_z: wp.array2d[wp.float32],
+        out_status: wp.array2d[wp.float32],
+        out_y_hat: wp.array2d[wp.float32],
+        out_z_hat: wp.array2d[wp.float32],
+        out_accel: wp.array2d[wp.float32],
+    ):
+        world, lane = wp.tid()
+        n = dims[world]
+        # World-uniform early return occurs before any collective tile operation.
+        if n < min_dimension or n > compute_width:
+            return
+        b = nbc[world]
+        c = b + nl[world]
+        inv = wp.tile_zeros(shape=(compute_width, compute_width), dtype=wp.float32, storage="shared")
+        rhs = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        xs = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        zs = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        zhs = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        rp_tile = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        rd_tile = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        rc_tile = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        ra_tile = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        for k in range((compute_width * compute_width + threads - 1) // threads):
+            index = lane + k * threads
+            if index < compute_width * compute_width:
+                row = index // compute_width
+                col = index % compute_width
+                inv[row, col] = inverse_transposed[world * storage_pitch + row, col]
+        xp = wp.float32(0.0)
+        yp = wp.float32(0.0)
+        zp = wp.float32(0.0)
+        pv = wp.float32(1.0)
+        qv = wp.float32(0.0)
+        lov = wp.float32(0.0)
+        hiv = wp.float32(0.0)
+        muv = wp.float32(0.0)
+        if lane < n:
+            xp = seed_x[world, lane]
+            yp = seed_y[world, lane]
+            zp = seed_z[world, lane]
+            pv = P[world, lane]
+            qv = q[world, lane]
+            lov = lower[world, lane]
+            hiv = upper[world, lane]
+            muv = mu[world, lane]
+        yh = wp.float32(0.0)
+        zh = wp.float32(0.0)
+        if lane < n:
+            yh = seed_y_hat[world, lane]
+            zh = seed_z_hat[world, lane]
+        zhs[lane] = zh
+        ap = a0
+        ra_prev = wp.float32(3.4028234663852886e38)
+        restarts = int(0)
+        rpmax = wp.float32(0.0)
+        rdmax = wp.float32(0.0)
+        rcmax = wp.float32(0.0)
+        converged = int(0)
+        iterations = int(0)
+        x = xp
+        y = yp
+        z = zp
+        restart = int(0)
+        afactor = wp.float32(0.0)
+        ra_previous = ra_prev
+        dx_norm = wp.float32(0.0)
+        dy_norm = wp.float32(0.0)
+        dz_norm = wp.float32(0.0)
+        rasum = wp.float32(0.0)
+        dx_tile = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        dy_tile = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        dz_tile = wp.tile_zeros(shape=threads, dtype=wp.float32, storage="shared")
+        _sync_threads()
+        for iteration in range(max_iterations):
+            correction = wp.float32(0.0)
+            if lane >= c and lane < n and (lane - c) % 3 == 2:
+                k = lane - 2
+                correction = muv * wp.sqrt(zhs[k] * zhs[k] + zhs[k + 1] * zhs[k + 1])
+            value = wp.float32(0.0)
+            if lane < n:
+                value = -qv - correction + eta * xp + rho * yh + zh
+            rhs[lane] = value
+            _sync_threads()
+            x = wp.float32(0.0)
+            if lane < n:
+                for j in range(n):
+                    x = x + inv[j, lane] * rhs[j]
+            xs[lane] = x
+            _sync_threads()
+            y = wp.float32(0.0)
+            if lane < n:
+                y = x - zh / rho
+                if lane < b:
+                    y = wp.clamp(y, lov, hiv)
+                elif lane < c:
+                    y = wp.max(y, wp.float32(0.0))
+                else:
+                    component = (lane - c) % 3
+                    k = lane - component
+                    projected = project_to_coulomb_cone(
+                        wp.vec3f(
+                            xs[k] - zhs[k] / rho, xs[k + 1] - zhs[k + 1] / rho, xs[k + 2] - zhs[k + 2] / rho
+                        ),
+                        muv,
+                    )
+                    y = projected[component]
+            z = zh + rho * (y - x)
+            zs[lane] = z
+            _sync_threads()
+            rp = wp.float32(0.0)
+            rd = wp.float32(0.0)
+            rc = wp.float32(0.0)
+            ra = wp.float32(0.0)
+            if lane < n:
+                rp = wp.abs(pv * (x - y))
+                rd = wp.abs((eta * (x - xp) + rho * (y - yh)) / pv)
+                dy = pv * (y - yh)
+                dz = (z - zh) / pv
+                ra = rho * dy * dy + dz * dz / rho
+                if lane < b:
+                    rc = wp.abs(compute_box_complementarity_residual(x, z, lov, hiv))
+                elif lane < c:
+                    rc = wp.abs(x * z)
+                elif (lane - c) % 3 == 0:
+                    rc = wp.abs(
+                        xs[lane] * zs[lane] + xs[lane + 1] * zs[lane + 1] + xs[lane + 2] * zs[lane + 2]
+                    )
+            rp_tile[lane] = rp
+            rd_tile[lane] = rd
+            rc_tile[lane] = rc
+            ra_tile[lane] = ra
+            dxv = wp.float32(0.0)
+            dyv = wp.float32(0.0)
+            dzv = wp.float32(0.0)
+            if lane < n:
+                dxv = pv * (x - xp)
+                dyv = pv * (y - yh)
+                dzv = (z - zh) / pv
+            dx_tile[lane] = dxv * dxv
+            dy_tile[lane] = dyv * dyv
+            dz_tile[lane] = dzv * dzv
+            _sync_threads()
+            rpmax = wp.tile_max(rp_tile)[0]
+            rdmax = wp.tile_max(rd_tile)[0]
+            rcmax = wp.tile_max(rc_tile)[0]
+            rasum = wp.tile_sum(ra_tile)[0]
+            iterations = iteration + 1
+            dx_norm = wp.sqrt(wp.tile_sum(dx_tile)[0])
+            dy_norm = wp.sqrt(wp.tile_sum(dy_tile)[0])
+            dz_norm = wp.sqrt(wp.tile_sum(dz_tile)[0])
+            ra_previous = ra_prev
+            restart = 0
+            if (
+                iterations > 1
+                and rpmax <= primal_tolerance
+                and rdmax <= dual_tolerance
+                and rcmax <= compl_tolerance
+            ):
+                converged = 1
+                break
+            if rasum < restart_tolerance * ra_prev:
+                a = wp.float32(0.5) * (wp.float32(1.0) + wp.sqrt(wp.float32(1.0) + wp.float32(4.0) * ap * ap))
+                momentum = (ap - wp.float32(1.0)) / a
+                afactor = momentum
+                yh = y + momentum * (y - yp)
+                zh = z + momentum * (z - zp)
+                ap = a
+                ra_prev = rasum
+            else:
+                yh = yp
+                zh = zp
+                ap = a0
+                ra_prev = ra_prev / restart_tolerance
+                restarts += 1
+                restart = 1
+                rasum = ra_prev
+                afactor = 0.0
+            xp = x
+            yp = y
+            zp = z
+            zhs[lane] = zh
+            _sync_threads()
+        # Scalar tile extraction/assignment is collective; global array writes below may diverge.
+        if lane < n:
+            out_x[world, lane] = x
+            out_y[world, lane] = y
+            out_z[world, lane] = z
+            out_y_hat[world, lane] = yh
+            out_z_hat[world, lane] = zh
+        if lane == 0:
+            out_status[world, 0] = wp.float32(iterations)
+            out_status[world, 1] = wp.float32(converged)
+            out_status[world, 2] = rpmax
+            out_status[world, 3] = rdmax
+            out_status[world, 4] = rcmax
+            out_status[world, 5] = wp.float32(restarts)
+            out_status[world, 6] = dx_norm
+            out_status[world, 7] = dy_norm
+            out_status[world, 8] = dz_norm
+            out_status[world, 9] = rasum
+            out_status[world, 10] = ra_previous
+            out_status[world, 11] = wp.float32(restart)
+            out_accel[world, 0] = ap
+            out_accel[world, 1] = afactor
+
+    return solve
