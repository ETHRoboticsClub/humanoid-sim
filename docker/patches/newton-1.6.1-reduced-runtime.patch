+                        if wp.static(HAS_TILE_MATMUL_TRANSPOSE_UPDATE):
+                            wp.tile_matmul_transpose_update(A_kk_tile, L_block, L_block, alpha=-1.0)
+                        else:
+                            L_block_T = wp.tile_transpose(L_block)
+                            wp.tile_matmul(L_block, L_block_T, A_kk_tile, alpha=-1.0)
