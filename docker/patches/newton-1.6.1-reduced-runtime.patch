+"""Direct-source RCM LLTB derivative, skipping only symbolic zero blocks.
+
+Gathers authoritative source lower-triangle entries under the free permutation;
+adds the original constrained diagonal shift before factor arithmetic. No K copy.
+
+No elementwise tile write is conditional on lane id. Every skip predicate is
+uniform for the world's cooperative block. Skipped lower output tiles are zeroed.
+"""
+
+from functools import cache
+
+import warp as wp
+
+from ...linalg.factorize._tile_builtins import HAS_TILE_MATMUL_TRANSPOSE_UPDATE
+from ...linalg.factorize.llt_blocked import get_float32_array_offset_ptr
+
+
+@cache
+def make_runtime_rcm_factor(block_size: int, skip_structural_zeros: bool):
+    @wp.kernel(module="unique", enable_backward=False)
+    def llt_blocked_factorize_kernel(
+        # Inputs:
+        dim: wp.array[wp.int32],
+        mio: wp.array[wp.int32],
+        D: wp.array[wp.float32],
+        source_dim: wp.array[wp.int32],
+        source_mio: wp.array[wp.int32],
+        bad: wp.array[wp.bool],
+        permutation: wp.array[wp.int32],
+        free: int,
+        sigma: float,
+        occupied: wp.array2d[wp.int32],
+        # Outputs:
+        L: wp.array[wp.float32],
+    ):
+        # Retrieve the thread index and thread-block configuration
+        tid, tid_block = wp.tid()
+        num_threads_per_block = wp.block_dim()
+
+        # Retrieve the matrix block dimensions and size
+        n_i = dim[tid]
+        A_i_start = mio[tid]
+
+        # Retrieve a pointer to the start of the i-th matrix in A
+        L_i_ptr = get_float32_array_offset_ptr(L, A_i_start)
+
+        # Create a temporary warp array pointing to the i-th matrix
+        L_i = wp.array(ptr=L_i_ptr, shape=(n_i, n_i), dtype=wp.float32)
+
+        # Round up active_matrix_size to next multiple of block_size
+        n_i_padded = ((n_i + block_size - 1) // block_size) * block_size
+
+        # Process the matrix in blocks along its leading dimension.
+        for k in range(0, n_i_padded, block_size):
+            end = k + block_size
+
+            # Load current diagonal block A[k:end, k:end]
+            # and update with contributions from previously computed blocks.
+            A_kk_tile = wp.tile_zeros(shape=(block_size, block_size), dtype=wp.float32, storage="shared")
+            num_tile_elements = block_size * block_size
+            num_iterations = (num_tile_elements + num_threads_per_block - 1) // num_threads_per_block
+            for load_index in range(num_iterations):
+                linear_index = (tid_block + load_index * num_threads_per_block) % num_tile_elements
+                row = linear_index // block_size
+                col = linear_index % block_size
+                logical_row = k + row
+                logical_col = k + col
+                value = wp.where(logical_row == logical_col, wp.float32(1), wp.float32(0))
+                if not bad[tid] and logical_row < n_i and logical_col < n_i:
+                    source_row = permutation[logical_row]
+                    source_col = permutation[logical_col]
+                    value = D[
+                        source_mio[tid]
+                        + wp.max(source_row, source_col) * source_dim[tid]
+                        + wp.min(source_row, source_col)
+                    ]
+                    if logical_row == logical_col and logical_row >= free:
+                        value = value + sigma
+                A_kk_tile[row, col] = value
+
+            # Update the diagonal block with contributions from previously computed blocks.
+            # ``tile_matmul(..., alpha=-1.0)`` accumulates ``A_kk_tile += -1 * L_block @ L_block_T``
+            # in-place, which avoids the intermediate ``L_L_T_block`` tile allocation that
+            # the ``A_kk_tile -= L_L_T_block`` form required.
+            if k > 0:
