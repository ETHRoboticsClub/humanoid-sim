+"""Three independent RHS recoveries sharing factor reads, with unchanged summation order."""
+import warp as wp
+from newton._src.solvers.kamino._src.linalg.factorize.llt_blocked import get_float32_array_offset_ptr
+
+@wp.kernel(enable_backward=False)
+def recovery_rhs3(
+    L: wp.array[wp.float32], dims: wp.array[wp.int32], mio: wp.array[wp.int32],
+    v: wp.array[wp.float32], x: wp.array2d[wp.float32], y: wp.array2d[wp.float32], yh: wp.array2d[wp.float32],
+    free: int, b0: wp.array[wp.float32], b1: wp.array[wp.float32], b2: wp.array[wp.float32],
+):
+    w, j = wp.tid()
+    n = dims[w]
+    a0 = wp.float32(0.0)
+    a1 = wp.float32(0.0)
+    a2 = wp.float32(0.0)
+    for k in range(n - free):
+        l = L[mio[w] + (free + k) * n + j]
+        a0 = a0 + l * x[w, k]
+        a1 = a1 + l * y[w, k]
+        a2 = a2 + l * yh[w, k]
+    vf = v[w * free + j]
+    b0[w * free + j] = -vf - a0
+    b1[w * free + j] = -vf - a1
+    b2[w * free + j] = -vf - a2
+
+
+def make_backward3(block=32):
+    @wp.kernel(module="unique", enable_backward=False)
+    def solve(
+        L: wp.array[wp.float32], dims: wp.array[wp.int32], mio: wp.array[wp.int32],
+        b0: wp.array[wp.float32], b1: wp.array[wp.float32], b2: wp.array[wp.float32], free: int,
+        x0: wp.array[wp.float32], x1: wp.array[wp.float32], x2: wp.array[wp.float32],
+    ):
+        w, lane = wp.tid()
+        threads = wp.block_dim()
+        n = dims[w]
+        lm = wp.array(ptr=get_float32_array_offset_ptr(L, mio[w]), shape=(n,n), dtype=wp.float32)
+        bv0 = wp.array(ptr=get_float32_array_offset_ptr(b0,w*free), shape=(free,1), dtype=wp.float32)
+        bv1 = wp.array(ptr=get_float32_array_offset_ptr(b1,w*free), shape=(free,1), dtype=wp.float32)
+        bv2 = wp.array(ptr=get_float32_array_offset_ptr(b2,w*free), shape=(free,1), dtype=wp.float32)
+        out0 = wp.array(ptr=get_float32_array_offset_ptr(x0,w*free), shape=(free,1), dtype=wp.float32)
+        out1 = wp.array(ptr=get_float32_array_offset_ptr(x1,w*free), shape=(free,1), dtype=wp.float32)
+        out2 = wp.array(ptr=get_float32_array_offset_ptr(x2,w*free), shape=(free,1), dtype=wp.float32)
+        padded = (free+block-1)//block*block
+        for iteration in range(padded//block):
+            i = padded-block-iteration*block
+            rhs0 = wp.tile_load(bv0,shape=(block,1),offset=(i,0),storage="shared")
+            rhs1 = wp.tile_load(bv1,shape=(block,1),offset=(i,0),storage="shared")
+            rhs2 = wp.tile_load(bv2,shape=(block,1),offset=(i,0),storage="shared")
+            diag = wp.tile_load(lm,shape=(block,block),offset=(i,i),storage="shared")
+            if i+block>free:
+                for chunk in range((block*block+threads-1)//threads):
+                    k = (lane+chunk*threads)%(block*block)
+                    row = k//block
+                    col = k%block
+                    value = diag[row,col]
+                    if i+row>=free or i+col>=free:
+                        value = wp.where(row==col,wp.float32(1.0),wp.float32(0.0))
+                    diag[row,col] = value
+            for j in range(i+block,padded,block):
+                lb = wp.tile_load(lm,shape=(block,block),offset=(j,i))
+                xb0 = wp.tile_load(out0,shape=(block,1),offset=(j,0))
+                xb1 = wp.tile_load(out1,shape=(block,1),offset=(j,0))
+                xb2 = wp.tile_load(out2,shape=(block,1),offset=(j,0))
+                wp.tile_matmul(wp.tile_transpose(lb),xb0,rhs0,alpha=-1.0)
+                wp.tile_matmul(wp.tile_transpose(lb),xb1,rhs1,alpha=-1.0)
+                wp.tile_matmul(wp.tile_transpose(lb),xb2,rhs2,alpha=-1.0)
+            wp.tile_upper_solve_inplace(wp.tile_transpose(diag),rhs0)
+            wp.tile_upper_solve_inplace(wp.tile_transpose(diag),rhs1)
+            wp.tile_upper_solve_inplace(wp.tile_transpose(diag),rhs2)
+            wp.tile_store(out0,rhs0,offset=(i,0))
+            wp.tile_store(out1,rhs1,offset=(i,0))
+            wp.tile_store(out2,rhs2,offset=(i,0))
+    return solve
