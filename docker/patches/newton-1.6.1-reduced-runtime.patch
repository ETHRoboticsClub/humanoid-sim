+    free: int,
+    width: int,
+    qF: wp.array[wp.float32],
+    qdense: wp.array[wp.float32],
+):
+    world, row = wp.tid()
+    value = wp.float32(0.0)
+    if not bad[world] and row < dim[world]:
+        value = q[vio[world] + permutation[row]]
+    qdense[world * width + row] = value
+    if row < free:
+        qF[world * free + row] = value
+
+
+@wp.kernel(enable_backward=False)
+def restore_runtime_free_order(
+    value: wp.array[wp.float32],
+    permutation: wp.array[wp.int32],
+    free: int,
+    output: wp.array[wp.float32],
+):
+    world, row = wp.tid()
+    output[world * free + permutation[row]] = value[world * free + row]
