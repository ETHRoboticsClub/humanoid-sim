+"""Deterministic constructor-only symbolic ordering and conservative block fill."""
+
+import numpy as np
+
+
+def rcm(A):
+    """Reverse Cuthill-McKee with deterministic minimum-degree component roots."""
+    A = A.copy()
+    np.fill_diagonal(A, False)
+    degree = A.sum(1)
+    remaining = set(range(len(A)))
+    order = []
+    while remaining:
+        root = min(remaining, key=lambda v: (degree[v], v))
+        remaining.remove(root)
+        queue = [root]
+        while queue:
+            u = queue.pop(0)
+            order.append(u)
+            children = sorted(
+                (int(v) for v in np.flatnonzero(A[u]) if int(v) in remaining), key=lambda v: (degree[v], v)
+            )
+            for v in children:
+                remaining.remove(v)
+            queue.extend(children)
+    return np.array(order[::-1])
+
+
+def minimum_degree(A):
+    """Exact greedy minimum degree on the filled graph, not SuiteSparse AMD."""
+    graph = [set(np.flatnonzero(A[i]).tolist()) - {i} for i in range(len(A))]
+    remaining = set(range(len(A)))
+    order = []
+    while remaining:
+        k = min(remaining, key=lambda v: (len(graph[v] & remaining), v))
+        ns = (graph[k] & remaining) - {k}
+        for v in ns:
+            graph[v].update(ns - {v})
+        remaining.remove(k)
+        order.append(k)
+    return np.array(order)
+
+
+def symbolic(A):
+    filled = A.copy()
+    L = np.eye(len(A), dtype=bool)
+    for k in range(len(A)):
+        ns = np.flatnonzero(filled[k, k + 1 :]) + k + 1
+        L[ns, k] = True
+        filled[np.ix_(ns, ns)] = True
+    return L
+
+
+def block_pattern(A, block=16):
+    n = len(A)
+    b = (n + block - 1) // block
+    return np.array(
+        [
+            [
+                bool(A[i * block : min((i + 1) * block, n), j * block : min((j + 1) * block, n)].any())
+                for j in range(b)
+            ]
+            for i in range(b)
+        ]
+    )
