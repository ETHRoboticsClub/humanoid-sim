+"""Per-world topology-only block fill; no Jacobian or factor values are inspected."""
+import warp as wp
+
+
+@wp.kernel(enable_backward=False)
+def collect_body_tile_bits(
+    coords: wp.array2d[wp.int32], starts: wp.array[wp.int32], counts: wp.array[wp.int32],
+    dims: wp.array[wp.int32], body_counts: wp.array[wp.int32], inverse_permutation: wp.array[wp.int32],
+    block: int, max_tiles: int, body_tiles: wp.array2d[wp.uint32], invalid: wp.array[wp.int32],
+):
+    world, entry = wp.tid()
+    if entry < counts[world]:
+        row = coords[starts[world]+entry,0]
+        column = coords[starts[world]+entry,1]
+        body = column//6
+        if row < 0 or row >= dims[world] or row >= inverse_permutation.shape[0] or column < 0 or column%6 != 0 or body >= body_counts[world]:
+            wp.atomic_or(invalid,world,1)
+        else:
+            tile = inverse_permutation[row]//block
+            if tile >= max_tiles:
+                wp.atomic_or(invalid,world,1)
+            else:
+                wp.atomic_or(body_tiles,world,body,wp.uint32(1)<<wp.uint32(tile))
+
+
+def make_symbolic_fill(max_tiles=20):
+    """Each world is owned by one thread; bitset fill is an integer exact operation."""
+    assert 1 <= max_tiles <= 32
+    Masks = wp.types.vector(length=max_tiles,dtype=wp.uint32)
+    @wp.kernel(module='unique',enable_backward=False)
+    def fill(
+        body_tiles: wp.array2d[wp.uint32], body_counts: wp.array[wp.int32],
+        dims: wp.array[wp.int32], block: int, invalid: wp.array[wp.int32],
+        occupied: wp.array2d[wp.uint32],
+    ):
+        world=wp.tid()
+        tiles=(dims[world]+block-1)//block
+        rows=Masks(wp.uint32(0))
+        if tiles>max_tiles or tiles<1:
+            invalid[world]=1
+        if invalid[world]!=0:
+            # Reject metadata by emitting conservative dense predicates.
+            for i in range(max_tiles):occupied[world,i]=wp.uint32(0xffffffff)
+        else:
+            # A body is a dense 6x6 mass block, so all incident row tiles form
+            # a clique. Diagonal regularization always contributes diagonals.
+            for i in range(tiles):
+                bits=wp.uint32(1)<<wp.uint32(i)
+                for body in range(body_counts[world]):
+                    body_bits=body_tiles[world,body]
+                    if body_bits & (wp.uint32(1)<<wp.uint32(i)):
+                        bits=bits|body_bits
+                rows[i]=bits
+            # Symmetric symbolic elimination. Preserve all original and filled
+            # edges; elimination k connects every surviving neighbor of k.
+            for k in range(tiles):
+                after_k=wp.uint32(0xffffffff)
+                if k<31:after_k=~((wp.uint32(1)<<wp.uint32(k+1))-wp.uint32(1))
+                else:after_k=wp.uint32(0)
+                neighbors=rows[k]&after_k
+                for i in range(k+1,tiles):
+                    if neighbors & (wp.uint32(1)<<wp.uint32(i)):
+                        rows[i]=rows[i]|neighbors
+            for i in range(max_tiles):
+                value=wp.uint32(0)
+                if i<tiles:value=rows[i]
+                occupied[world,i]=value
+    return fill
