+"""Constructor-only bilateral row/body topology from finalized ModelKamino.
+
+No captured fixtures, robot dimensions, numeric Jacobian values or current poses.
+Matches SparseSystemJacobians.finalize's dynamic/kinematic coordinate loops.
+"""
+
+import hashlib
+from dataclasses import dataclass
+
+import numpy as np
+
+
+@dataclass(frozen=True)
+class BilateralTopology:
+    graph: np.ndarray
+    row_body: np.ndarray
+    fingerprint: str
+    worlds_verified: int
+
+
+def common_bilateral_topology(model):
+    """Read immutable model arrays once, after constraint offsets are finalized.
+
+    Reject heterogeneous row/body connectivity rather than selecting a schedule
+    that might skip a real nonzero in another world. All constrained coupling is
+    added densely by the schedule builder, independently of this free graph.
+    """
+    world_count = int(model.size.num_worlds)
+    free_counts = model.info.num_joint_bilateral_cts.numpy().astype(np.int64)
+    if world_count < 1 or len(free_counts) != world_count or not np.all(free_counts == free_counts[0]):
+        raise ValueError("A common bilateral prefix is required")
+    free = int(free_counts[0])
+    if free <= 0:
+        raise ValueError("A positive bilateral prefix is required")
+    world_offsets = model.info.total_cts_offset.numpy().astype(np.int64)
+    body_offsets = model.info.bodies_offset.numpy().astype(np.int64)
+    body_dofs = model.info.num_body_dofs.numpy().astype(np.int64)
+    if np.any(body_dofs % 6):
+        raise ValueError("Expected six spatial degrees of freedom per body")
+    body_counts = body_dofs // 6
+    joints = model.joints
+    worlds = joints.wid.numpy().astype(np.int64)
+    follower = joints.bid_F.numpy().astype(np.int64)
+    base = joints.bid_B.numpy().astype(np.int64)
+    dynamic_counts = joints.num_dynamic_cts.numpy().astype(np.int64)
+    kinematic_counts = joints.num_kinematic_cts.numpy().astype(np.int64)
+    bilateral_counts = joints.num_bilateral_cts.numpy().astype(np.int64)
+    if not np.array_equal(dynamic_counts + kinematic_counts, bilateral_counts):
+        raise ValueError("Unknown bilateral row partition")
+
+    def offsets(name, counts):
+        array = getattr(joints, name)
+        if array is None:
+            if np.any(counts):
+                raise ValueError(f"Required finalized constraint offsets are missing: {name}")
+            return np.zeros_like(counts)
+        return array.numpy().astype(np.int64)
+
+    dynamic_offsets = offsets("dynamic_cts_offset_total_cts", dynamic_counts)
+    kinematic_offsets = offsets("kinematic_cts_offset_total_cts", kinematic_counts)
+    by_world = [[] for _ in range(world_count)]
+    owners = np.full((world_count, free), -1, dtype=np.int64)
+    for j, w in enumerate(worlds):
+        if not 0 <= w < world_count:
+            raise ValueError("Joint world index is invalid")
+        bodies = [follower[j]]
+        if base[j] >= 0:
+            bodies.append(base[j])
+        local_bodies = [int(b - body_offsets[w]) for b in bodies]
+        if any(b < 0 or b >= body_counts[w] for b in local_bodies):
+            raise ValueError("Joint refers outside its world's body interval")
+        for count, offset in (
+            (dynamic_counts[j], dynamic_offsets[j]),
+            (kinematic_counts[j], kinematic_offsets[j]),
+        ):
+            if not count:
+                continue
+            first = int(offset - world_offsets[w])
+            if first < 0 or first + count > free:
+                raise ValueError("Bilateral rows fall outside the free prefix")
+            for row in range(first, first + int(count)):
+                if owners[w, row] >= 0:
+                    raise ValueError("Overlapping bilateral row ownership")
+                owners[w, row] = j
+                by_world[w].extend((row, b) for b in local_bodies)
+    if np.any(owners < 0):
+        raise ValueError("Bilateral prefix contains rows not described by joint metadata")
+    canonical = np.unique(np.asarray(by_world[0], dtype=np.int64), axis=0)
+    for coordinates in by_world[1:]:
+        if not np.array_equal(np.unique(np.asarray(coordinates, dtype=np.int64), axis=0), canonical):
+            raise ValueError("Bilateral row/body topology differs between worlds")
+    incidence = np.zeros((free, int(canonical[:, 1].max()) + 1), dtype=np.int32)
+    incidence[canonical[:, 0], canonical[:, 1]] = 1
+    graph = incidence @ incidence.T > 0
+    np.fill_diagonal(graph, True)
+    graph.flags.writeable = False
+    canonical.flags.writeable = False
+    return BilateralTopology(graph, canonical, hashlib.sha256(canonical.tobytes()).hexdigest(), world_count)
