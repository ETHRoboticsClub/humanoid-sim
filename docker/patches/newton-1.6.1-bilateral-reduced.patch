+def make_free_solve(transpose=False, block=32):
+    @wp.kernel(module="unique", enable_backward=False)
+    def solve(
+        L: wp.array[wp.float32],
+        dims: wp.array[wp.int32],
+        mio: wp.array[wp.int32],
+        b: wp.array[wp.float32],
+        free: int,
+        result: wp.array[wp.float32],
+    ):
+        w, lane = wp.tid()
+        threads = wp.block_dim()
+        n = dims[w]
+        lm = wp.array(ptr=get_float32_array_offset_ptr(L, mio[w]), shape=(n, n), dtype=wp.float32)
+        bv = wp.array(ptr=get_float32_array_offset_ptr(b, w * free), shape=(free, 1), dtype=wp.float32)
+        out = wp.array(ptr=get_float32_array_offset_ptr(result, w * free), shape=(free, 1), dtype=wp.float32)
+        padded = (free + block - 1) // block * block
+        for iteration in range(padded // block):
+            i = iteration * block
+            if wp.static(transpose):
+                i = padded - block - iteration * block
+            rhs = wp.tile_load(bv, shape=(block, 1), offset=(i, 0), storage="shared")
+            diag = wp.tile_load(lm, shape=(block, block), offset=(i, i), storage="shared")
+            if i + block > free:
+                for chunk in range((block * block + threads - 1) // threads):
+                    k = (lane + chunk * threads) % (block * block)
+                    row = k // block
+                    col = k % block
+                    value = diag[row, col]
+                    if i + row >= free or i + col >= free:
+                        value = wp.where(row == col, wp.float32(1.0), wp.float32(0.0))
+                    diag[row, col] = value
+            if wp.static(transpose):
+                for j in range(i + block, padded, block):
+                    lb = wp.tile_load(lm, shape=(block, block), offset=(j, i))
+                    xb = wp.tile_load(out, shape=(block, 1), offset=(j, 0))
+                    wp.tile_matmul(wp.tile_transpose(lb), xb, rhs, alpha=-1.0)
+                wp.tile_upper_solve_inplace(wp.tile_transpose(diag), rhs)
+            else:
