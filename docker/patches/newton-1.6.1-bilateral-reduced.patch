+@wp.kernel(enable_backward=False)
+def prepare_augmented(
+    D: wp.array3d[wp.float32],
+    q: wp.array2d[wp.float32],
+    dims: wp.array[wp.int32],
+    mio: wp.array[wp.int32],
+    free: int,
+    sigma: float,
+    K: wp.array[wp.float32],
+    qF: wp.array[wp.float32],
+):
+    w, row, col = wp.tid()
+    n = dims[w]
+    if row < n and col < n:
+        value = D[w, row, col]
+        if row == col and row >= free:
+            value = value + sigma
+        K[mio[w] + row * n + col] = value
+    if row == 0 and col < free:
+        qF[w * free + col] = q[w, col]
+
+
+@wp.kernel(enable_backward=False)
+def reduced_q(
+    L: wp.array[wp.float32],
+    dims: wp.array[wp.int32],
+    mio: wp.array[wp.int32],
+    v: wp.array[wp.float32],
+    q: wp.array2d[wp.float32],
+    free: int,
+    result: wp.array2d[wp.float32],
+):
+    w, k = wp.tid()
+    n = dims[w]
+    value = wp.float32(0.0)
+    if k < n - free:
+        acc = wp.float32(0.0)
+        for j in range(free):
+            acc = acc + L[mio[w] + (free + k) * n + j] * v[w * free + j]
+        value = q[w, free + k] - acc
+    result[w, k] = value
+
+
+@wp.kernel(enable_backward=False)
+def recovery_rhs(
+    L: wp.array[wp.float32],
+    dims: wp.array[wp.int32],
+    mio: wp.array[wp.int32],
+    v: wp.array[wp.float32],
+    yc: wp.array2d[wp.float32],
+    free: int,
+    result: wp.array[wp.float32],
+):
+    w, j = wp.tid()
+    n = dims[w]
+    acc = wp.float32(0.0)
+    for k in range(n - free):
+        acc = acc + L[mio[w] + (free + k) * n + j] * yc[w, k]
+    result[w * free + j] = -v[w * free + j] - acc
