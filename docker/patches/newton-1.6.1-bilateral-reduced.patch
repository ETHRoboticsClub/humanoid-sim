+"""Opt-in experimental bilateral elimination with preallocated GPU workspace.
+
+Default full PADMM remains separate. Per-world residual_scope identifies full
+(0) versus reduced (1) stopping diagnostics. Original-equation diagnostics are
+separate; they are not solution-error estimates or acceptance thresholds.
+"""
+
+import dataclasses
+
+import numpy as np
+import warp as wp
+
+from .kernels import _update_delassus_proximal_regularization
+from .reduced_iteration import make_kernel
+from .reduced_runtime_kernels import (
+    bridge,
+    check_factor,
+    check_output,
+    classify,
+    merge_status,
+    merge_vectors,
+    original_diagnostics,
+    pack_vectors,
+    sanitize_rejected_factor,
+)
+from .reduced_setup import make_free_solve, make_reduced_inverse, make_reduced_q, recovery_rhs
+from .reduced_direct_factor import make_runtime_direct_factor, pack_runtime_q
+
+
+class ReducedRuntime:
+    """Constructor host reads only; solve launches preallocated Warp kernels."""
+
+    def __init__(self, owner, model):
+        cfg = owner.config[0]
+        if not owner._use_acceleration or not owner._use_graph_conditionals or owner._collect_info:
+            raise ValueError(
+                "bilateral_reduced prototype requires acceleration, graph conditionals, and collect_info=False"
+            )
+        if cfg.penalty_update_method != "fixed" or any(
+            dataclasses.asdict(c) != dataclasses.asdict(cfg) for c in owner.config
+        ):
+            raise ValueError("bilateral_reduced prototype requires homogeneous fixed-penalty configuration")
+        free = model.info.num_joint_bilateral_cts.numpy()
+        if len(set(free.tolist())) != 1 or int(free[0]) <= 0:
+            raise ValueError("bilateral_reduced prototype requires a positive common bilateral prefix")
+        if cfg.reduced_capacity not in (32, 64, 96, 128):
+            raise ValueError("reduced_capacity must be one of 32,64,96,128")
+        self.cfg = cfg
+        self.free = int(free[0])
+        self.capacity = cfg.reduced_capacity
+        self.width = self.free + self.capacity
+        self.count = model.size.num_worlds
+        self.device = model.device
+        # Match _initialize_solver: config.eta and config.rho_0 are each
+        # stored as FP32 before their FP32 addition. Adding Python doubles
+        # and casting only the sum can differ by one ULP for valid configs.
+        self.sigma = float(np.float32(np.float32(cfg.eta) + np.float32(cfg.rho_0)))
+        self.owner = owner
+        self.residual_scope_description = {
+            0: "original full PADMM",
+            1: "reduced constrained-coordinate PADMM",
+        }
+        self.original_diagnostic_names = (
+            "stationarity_constraint_velocity_inf",
+            "feasibility_impulse_inf",
+            "natural_map_preconditioned_inf",
+            "complementarity_inf",
+        )
+        if self.count * self.width * self.width >= 2**31:
+            raise ValueError("Reduced matrix offsets exceed int32")
+        with wp.ScopedDevice(self.device):
+
+            def z(shape, dtype=wp.float32):
+                return wp.zeros(shape, dtype=dtype)
+
+            self.dim = z(self.count, wp.int32)
+            self.rdim = z(self.count, wp.int32)
+            self.boxes = z(self.count, wp.int32)
+            self.limits = z(self.count, wp.int32)
+            self.mio = wp.array(
+                np.arange(self.count, dtype=np.int32) * self.width * self.width, dtype=wp.int32
+            )
+            self.bad = z(self.count, wp.bool)
+            self.bad_count = z(1, wp.int32)
+            self.residual_scope = z(self.count, wp.int32)
+            self.L = z(self.count * self.width * self.width)
+            self.qF = z(self.count * self.free)
+            self.v = z(self.count * self.free)
+            self.bF = z(self.count * self.free)
+            self.q = z(self.count * self.width)
+            self.qr = z(self.count * self.capacity)
