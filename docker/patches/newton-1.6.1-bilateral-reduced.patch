+        xx = rx[w, j]
+        yy = ry[w, j]
+        zz = rz[w, j]
+        hh = ryh[w, j]
+        hz = rzh[w, j]
+    idx = vio[w] + k
+    x[idx] = xx
+    y[idx] = yy
+    z[idx] = zz
+    xp[idx] = xx
+    yp[idx] = yy
+    zp[idx] = zz
+    yh[idx] = hh
+    zh[idx] = hz
+
+
+@wp.kernel(enable_backward=False)
+def merge_status(
+    bad: wp.array[bool],
