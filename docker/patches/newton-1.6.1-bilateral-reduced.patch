+"""Experimental reduced solver packing, validation and publication kernels."""
+
+import warp as wp
+
+from .math import compute_box_complementarity_residual, project_to_coulomb_cone
+from .types import PADMMStatus
+
+
+@wp.kernel(enable_backward=False)
+def classify(
+    dim: wp.array[int],
+    njc: wp.array[int],
+    nbc: wp.array[int],
+    nl: wp.array[int],
+    nc: wp.array[int],
+    bcgo: wp.array[int],
+    lcgo: wp.array[int],
+    ccgo: wp.array[int],
+    free: int,
+    capacity: int,
+    work_dim: wp.array[int],
+    red_dim: wp.array[int],
+    boxes: wp.array[int],
+    limits: wp.array[int],
+    bad: wp.array[bool],
+):
+    w = wp.tid()
+    n = dim[w]
+    r = n - free
+    invalid = (
+        njc[w] != free
+        or bcgo[w] != free
+        or lcgo[w] != free + nbc[w]
+        or ccgo[w] != free + nbc[w] + nl[w]
+        or n != free + nbc[w] + nl[w] + 3 * nc[w]
+        or r <= 0
+        or r > capacity
+    )
+    bad[w] = invalid
+    work_dim[w] = wp.where(invalid, free + 1, n)
+    red_dim[w] = wp.where(invalid, 1, r)
+    boxes[w] = wp.where(invalid, 0, nbc[w])
+    limits[w] = wp.where(invalid, 1, nl[w])
+
+
+@wp.kernel(enable_backward=False)
+def pack_matrix(
+    D: wp.array[float],
+    q: wp.array[float],
+    dim: wp.array[int],
+    mio: wp.array[int],
+    vio: wp.array[int],
+    wdim: wp.array[int],
+    wmio: wp.array[int],
+    bad: wp.array[bool],
+    free: int,
+    width: int,
+    sigma: float,
+    K: wp.array[float],
+    qF: wp.array[float],
+    qdense: wp.array[float],
+):
+    w, i, j = wp.tid()
+    n = wdim[w]
+    if i < n and j < n:
+        value = wp.float32(0.0)
+        if bad[w]:
+            if i == j:
+                value = 1.0
+        else:
+            value = D[mio[w] + i * dim[w] + j]
+            if i == j and i >= free:
+                value = value + sigma
+        K[wmio[w] + i * n + j] = value
+    if j == 0:
+        value = wp.float32(0.0)
+        if not bad[w] and i < dim[w]:
+            value = q[vio[w] + i]
+        qdense[w * width + i] = value
+        if i < free:
+            qF[w * free + i] = value
+
+
+@wp.kernel(enable_backward=False)
+def pack_vectors(
+    P: wp.array[float],
+    lower: wp.array[float],
+    upper: wp.array[float],
+    mu: wp.array[float],
+    vio: wp.array[int],
+    bcio: wp.array[int],
+    cio: wp.array[int],
+    rdim: wp.array[int],
+    nbc: wp.array[int],
+    nl: wp.array[int],
+    bad: wp.array[bool],
+    free: int,
+    xp: wp.array[float],
+    yp: wp.array[float],
+    zp: wp.array[float],
+    yh: wp.array[float],
+    zh: wp.array[float],
+    outP: wp.array2d[float],
+    outlo: wp.array2d[float],
+    outhi: wp.array2d[float],
+    outmu: wp.array2d[float],
+    outx: wp.array2d[float],
+    outy: wp.array2d[float],
+    outz: wp.array2d[float],
+    outyh: wp.array2d[float],
+    outzh: wp.array2d[float],
+):
+    w, k = wp.tid()
+    p = wp.float32(1.0)
+    lo = wp.float32(0.0)
+    hi = wp.float32(0.0)
+    m = wp.float32(0.0)
+    x = wp.float32(0.0)
+    y = wp.float32(0.0)
+    z = wp.float32(0.0)
+    a = wp.float32(0.0)
+    b = wp.float32(0.0)
+    if k < rdim[w] and not bad[w]:
+        idx = vio[w] + free + k
+        p = P[idx]
+        x = xp[idx]
+        y = yp[idx]
+        z = zp[idx]
+        a = yh[idx]
+        b = zh[idx]
+        if k < nbc[w]:
+            lo = lower[bcio[w] + k]
+            hi = upper[bcio[w] + k]
+        if k >= nbc[w] + nl[w]:
+            m = mu[cio[w] + (k - nbc[w] - nl[w]) // 3]
+    outP[w, k] = p
+    outlo[w, k] = lo
+    outhi[w, k] = hi
+    outmu[w, k] = m
+    outx[w, k] = x
+    outy[w, k] = y
+    outz[w, k] = z
+    outyh[w, k] = a
+    outzh[w, k] = b
+
+
+@wp.kernel(enable_backward=False)
+def check_factor(L: wp.array[float], dim: wp.array[int], mio: wp.array[int], bad: wp.array[bool]):
+    w = wp.tid()
+    n = dim[w]
+    invalid = bad[w]
+    for i in range(n):
+        value = L[mio[w] + i * n + i]
+        if not wp.isfinite(value) or value <= 0.0:
+            invalid = True
+    bad[w] = invalid
+
+
+@wp.kernel(enable_backward=False)
+def sanitize_rejected_factor(L: wp.array[float], dim: wp.array[int], mio: wp.array[int], bad: wp.array[bool]):
+    w, lane = wp.tid()
+    if not bad[w]:
+        return
+    n = dim[w]
+    for index in range(lane, n * n, 1024):
+        i = index // n
+        j = index % n
+        L[mio[w] + index] = wp.where(i == j, wp.float32(1.0), wp.float32(0.0))
+
+
+@wp.kernel(enable_backward=False)
+def bridge(
+    inverse: wp.array[float],
+    qr: wp.array[float],
+    dims: wp.array[int],
+    capacity: int,
+    out: wp.array2d[float],
+    outq: wp.array2d[float],
+):
+    w, i, j = wp.tid()
+    r = dims[w]
+    value = wp.float32(0.0)
+    if i < r and j < r:
+        value = inverse[w * capacity * capacity + j * capacity + i]
+    out[w * capacity + i, j] = value
+    if j == 0:
+        value = wp.float32(0.0)
+        if i < r:
+            value = qr[w * capacity + i]
+        outq[w, i] = value
+
+
+@wp.kernel(enable_backward=False)
+def check_output(
+    x: wp.array2d[float],
+    y: wp.array2d[float],
+    z: wp.array2d[float],
+    yh: wp.array2d[float],
+    zh: wp.array2d[float],
+    xf: wp.array[float],
+    yf: wp.array[float],
+    yhf: wp.array[float],
+    status: wp.array2d[float],
+    rdim: wp.array[int],
+    free: int,
+    bad: wp.array[bool],
+    bad_count: wp.array[int],
+):
+    w = wp.tid()
+    invalid = bad[w]
+    for k in range(rdim[w]):
+        if (
+            not wp.isfinite(x[w, k])
+            or not wp.isfinite(y[w, k])
+            or not wp.isfinite(z[w, k])
+            or not wp.isfinite(yh[w, k])
+            or not wp.isfinite(zh[w, k])
+        ):
+            invalid = True
+    for k in range(free):
+        if (
+            not wp.isfinite(xf[w * free + k])
+            or not wp.isfinite(yf[w * free + k])
+            or not wp.isfinite(yhf[w * free + k])
+        ):
+            invalid = True
+    for k in range(12):
+        if not wp.isfinite(status[w, k]):
+            invalid = True
+    bad[w] = invalid
+    if invalid:
+        wp.atomic_add(bad_count, 0, 1)
+
+
+@wp.kernel(enable_backward=False)
+def merge_vectors(
+    dim: wp.array[int],
+    vio: wp.array[int],
+    bad: wp.array[bool],
+    free: int,
+    rx: wp.array2d[float],
+    ry: wp.array2d[float],
+    rz: wp.array2d[float],
+    ryh: wp.array2d[float],
+    rzh: wp.array2d[float],
+    xf: wp.array[float],
+    yf: wp.array[float],
+    yhf: wp.array[float],
+    x: wp.array[float],
+    y: wp.array[float],
+    z: wp.array[float],
+    xp: wp.array[float],
+    yp: wp.array[float],
+    zp: wp.array[float],
+    yh: wp.array[float],
+    zh: wp.array[float],
+):
