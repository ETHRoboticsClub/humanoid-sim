+    s.r_a = source[w, 9]
+    s.r_a_p = source[w, 9]
+    s.r_a_pp = source[w, 10]
+    s.restart = int(source[w, 11])
+    status[w] = s
+    a[w] = accel[w, 0]
+    ap[w] = accel[w, 0]
+    af[w] = accel[w, 1]
+
+
+@wp.kernel(enable_backward=False)
